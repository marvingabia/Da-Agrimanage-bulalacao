# ============================================================
# DA-AgriManage — Environment Variables
# Copy this file to .env for local development.
# For Vercel: add each key in Project → Settings → Environment Variables
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=production
SESSION_SECRET=change-this-to-a-long-random-string

# ── Admin Account ───────────────────────────────────────────
# Default admin login — change ADMIN_PASSWORD before deploying!
ADMIN_EMAIL=mj@gmail.com
ADMIN_PASSWORD=admin2025

# ── MySQL Database ───────────────────────────────────────────
# Recommended free cloud providers:
#   • Filess.io  → DB_PORT=3307, DB_SSL=false
#   • Railway    → DB_PORT=3306, DB_SSL=true
#   • Clever Cloud → DB_PORT=3306, DB_SSL=true
#   • PlanetScale → DB_PORT=3306, DB_SSL=true
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=da_agrimanage
DB_SSL=false

# ── Google OAuth ─────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/
# Leave as placeholder values to DISABLE Google login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local dev:
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# For production (replace with your Vercel URL):
# GOOGLE_CALLBACK_URL=https://your-app.vercel.app/auth/google/callback

# ── Email (Gmail) ────────────────────────────────────────────
# Enable 2FA on Gmail → App Passwords → generate one
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# ── SMS (Semaphore PH) ───────────────────────────────────────
# Get API key from: https://semaphore.co
SEMAPHORE_API_KEY=your-semaphore-api-key
