<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - iBarangay Agricultural System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 0;
        }
        
        .background-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="75" cy="75" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="50" cy="10" r="0.5" fill="rgba(255,255,255,0.05)"/><circle cx="10" cy="60" r="0.5" fill="rgba(255,255,255,0.05)"/><circle cx="90" cy="40" r="0.5" fill="rgba(255,255,255,0.05)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
            opacity: 0.3;
            z-index: 1;
        }
        
        .register-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 500px;
            padding: 2rem;
        }
        
        .register-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 3rem 2.5rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: center;
        }
        
        .register-header {
            margin-bottom: 2rem;
        }
        
        .register-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.5rem;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }
        
        .register-subtitle {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            font-weight: 400;
            margin-bottom: 0;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        .form-label {
            color: white;
            font-weight: 500;
            margin-bottom: 0.5rem;
            display: block;
            font-size: 0.95rem;
        }
        
        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 12px;
            padding: 1rem 1.25rem;
            color: white;
            font-size: 1rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            width: 100%;
        }
        
        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.12);
            color: white;
            outline: none;
        }

        /* Select: white arrow icon */
        .form-select {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23ffffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m1 6 7 7 7-7'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 14px 10px;
        }
        
        /* Dropdown option list — must use solid colors so text is always readable */
        .form-select option,
        .form-select optgroup {
            background: #1e3a2f;
            color: #f1f5f9;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem;
        }

        /* First "placeholder" option */
        .form-select option[value=""] {
            color: #94a3b8;
        }
        
        .register-btn {
            width: 100%;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            border-radius: 12px;
            padding: 1rem;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            margin: 2rem 0 1.5rem 0;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }
        
        .register-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }
        
        .register-btn:active {
            transform: translateY(0);
        }
        
        .login-link {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.95rem;
        }
        
        .login-link a {
            color: #4285f4;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }
        
        .login-link a:hover {
            color: #1a73e8;
        }
        
        .alert {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.3);
            color: white;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(10px);
        }
        
        .farmer-fields {
            display: block;
        }
        
        .farmer-fields.hidden {
            display: none;
        }
        
        @media (max-width: 768px) {
            .register-container {
                padding: 1rem;
            }
            
            .register-card {
                padding: 2rem 1.5rem;
            }
            
            .register-title {
                font-size: 2rem;
            }
            
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="background-overlay"></div>
    
    <div class="register-container">
        <div class="register-card">
            <div class="register-header">
                <h1 class="register-title">Create Account</h1>
                <p class="register-subtitle">Join iBarangay Agricultural Management System</p>
            </div>
            
            {{#if error}}
            <div class="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                {{error}}
            </div>
            {{/if}}
            
            <form action="/register" method="POST" id="registerForm">
                <!-- Role Selection -->
                <div class="form-group">
                    <label for="role" class="form-label">I am registering as</label>
                    <select class="form-select" id="role" name="role" required onchange="toggleRoleFields()">
                        <option value="">Select your role</option>
                        <option value="farmer">Farmer (Magsasaka)</option>
                        <option value="staff">Staff (Kawani ng Tanggapan)</option>
                    </select>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="name" class="form-label">Full Name</label>
                        <input 
                            type="text" 
                            class="form-control" 
                            id="name" 
                            name="name" 
                            placeholder="Enter your full name"
                            required
                        >
                    </div>
                    
                    <div class="form-group">
                        <label for="email" class="form-label">Email Address</label>
                        <input 
                            type="email" 
                            class="form-control" 
                            id="email" 
                            name="email" 
                            placeholder="Enter your email"
                            required
                        >
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="phone" class="form-label">Phone Number</label>
                        <input 
                            type="tel" 
                            class="form-control" 
                            id="phone" 
                            name="phone" 
                            placeholder="Enter your phone number"
                            required
                        >
                    </div>
                    
                    <div class="form-group">
                        <label for="barangay" class="form-label">Barangay</label>
                        <select class="form-select" id="barangay" name="barangay" required>
                            <option value="">Select Barangay</option>
                            <option value="Bagong Sikat">Bagong Sikat</option>
                            <option value="Balatasan">Balatasan</option>
                            <option value="Benli">Benli</option>
                            <option value="Cabugao">Cabugao</option>
                            <option value="Cambunang">Cambunang</option>
                            <option value="Campaasan">Campaasan</option>
                            <option value="Maasin">Maasin</option>
                            <option value="Maujao">Maujao</option>
                            <option value="Milagrosa">Milagrosa</option>
                            <option value="Nasukob">Nasukob</option>
                            <option value="Poblacion">Poblacion</option>
                            <option value="San Francisco">San Francisco</option>
                            <option value="San Isidro">San Isidro</option>
                            <option value="San Juan">San Juan</option>
                            <option value="San Roque">San Roque</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input 
                        type="password" 
                        class="form-control" 
                        id="password" 
                        name="password" 
                        placeholder="Create a strong password"
                        required
                        minlength="6"
                    >
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword" class="form-label">Confirm Password</label>
                    <input 
                        type="password" 
                        class="form-control" 
                        id="confirmPassword" 
                        placeholder="Re-enter your password"
                        required
                        minlength="6"
                    >
                    <small id="passwordError" class="text-danger" style="display: none; margin-top: 0.5rem;">
                        <i class="fas fa-exclamation-circle me-1"></i>Passwords do not match!
                    </small>
                </div>
                
                <!-- Farmer-specific fields -->
                <div class="farmer-fields hidden" id="farmerFields">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="landArea" class="form-label">Land Area (hectares)</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="landArea" 
                                name="landArea" 
                                placeholder="e.g., 2.5"
                                step="0.1"
                                min="0"
                            >
                        </div>
                        
                        <div class="form-group">
                            <label for="landType" class="form-label">Land Type</label>
                            <select class="form-select" id="landType" name="landType">
                                <option value="">Select Land Type</option>
                                <option value="Rice Field">Rice Field</option>
                                <option value="Corn Field">Corn Field</option>
                                <option value="Vegetable Farm">Vegetable Farm</option>
                                <option value="Fruit Orchard">Fruit Orchard</option>
                                <option value="Mixed Farming">Mixed Farming</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <!-- Staff-specific fields -->
                <div class="staff-fields hidden" id="staffFields">
                    <div class="form-group">
                        <label for="dob" class="form-label">Date of Birth</label>
                        <input type="date" class="form-control" id="dob" name="dob" max="">
                        <small class="form-text text-muted">You must be at least 18 years old</small>
                    </div>
                    
                    <div class="alert" style="background: rgba(59, 130, 246, 0.2); border-color: rgba(59, 130, 246, 0.3); margin-top: 1rem;">
                        <i class="fas fa-info-circle me-2"></i>
                        <small><strong>Note:</strong> Your staff account will require admin approval before you can login.</small>
                    </div>
                </div>
                
                <button type="submit" class="btn register-btn" id="submitBtn">
                    <i class="fas fa-user-plus me-2"></i>
                    <span id="submitBtnText">Create Account</span>
                </button>
            </form>
            
            <div class="login-link">
                Already have an account? <a href="/login">Sign in here</a>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Toggle role-specific fields
        function toggleRoleFields() {
            const role = document.getElementById('role').value;
            const farmerFields = document.getElementById('farmerFields');
            const staffFields = document.getElementById('staffFields');
            const landArea = document.getElementById('landArea');
            const landType = document.getElementById('landType');
            const dob = document.getElementById('dob');
            const submitBtnText = document.getElementById('submitBtnText');
            
            // Set max date for DOB (18 years ago)
            const today = new Date();
            const maxDate = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());
            dob.max = maxDate.toISOString().split('T')[0];
            
            if (role === 'farmer') {
                farmerFields.classList.remove('hidden');
                staffFields.classList.add('hidden');
                landArea.required = true;
                landType.required = true;
                dob.required = false;
                if (submitBtnText) submitBtnText.textContent = 'Register as Farmer';
            } else if (role === 'staff') {
                farmerFields.classList.add('hidden');
                staffFields.classList.remove('hidden');
                landArea.required = false;
                landType.required = false;
                dob.required = true;
                if (submitBtnText) submitBtnText.textContent = 'Register as Staff';
            } else {
                farmerFields.classList.add('hidden');
                staffFields.classList.add('hidden');
                landArea.required = false;
                landType.required = false;
                dob.required = false;
                if (submitBtnText) submitBtnText.textContent = 'Create Account';
            }
        }
        
        // Form submission with loading state
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;
            const role = document.getElementById('role').value;
            
            // Validate role selection
            if (!role) {
                e.preventDefault();
                Swal.fire({
                    icon: 'warning',
                    title: 'Select Your Role',
                    text: 'Please select whether you are registering as a Farmer or Staff.',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#f59e0b'
                });
                return;
            }
            
            // Validate password match
            if (passwordInput.value !== confirmPasswordInput.value) {
                e.preventDefault();
                
                Swal.fire({
                    icon: 'error',
                    title: 'Password Mismatch!',
                    text: 'Your passwords do not match. Please make sure both password fields are the same.',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#dc3545'
                });
                
                confirmPasswordInput.focus();
                return;
            }
            
            // Validate farmer fields if farmer role selected
            if (role === 'farmer') {
                const landArea = document.getElementById('landArea').value;
                const landType = document.getElementById('landType').value;
                
                if (!landArea || !landType) {
                    e.preventDefault();
                    
                    Swal.fire({
                        icon: 'warning',
                        title: 'Incomplete Information',
                        text: 'Please fill in all farmer-specific fields (Land Area and Land Type).',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#f59e0b'
                    });
                    return;
                }
            }
            
            // Validate staff fields if staff role selected
            if (role === 'staff') {
                const dob = document.getElementById('dob').value;
                
                if (!dob) {
                    e.preventDefault();
                    
                    Swal.fire({
                        icon: 'warning',
                        title: 'Incomplete Information',
                        text: 'Please enter your Date of Birth.',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#f59e0b'
                    });
                    return;
                }
                
                // Validate age (must be 18+)
                const birthDate = new Date(dob);
                const today = new Date();
                const age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                
                if (age < 18 || (age === 18 && monthDiff < 0)) {
                    e.preventDefault();
                    
                    Swal.fire({
                        icon: 'warning',
                        title: 'Age Requirement',
                        text: 'You must be at least 18 years old to register as staff.',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#f59e0b'
                    });
                    return;
                }
            }
            
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Creating Account...';
            submitBtn.disabled = true;
            
            // Re-enable button after 5 seconds in case of error
            setTimeout(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }, 5000);
        });
        
        // Auto-focus role selector
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('role').focus();
        });
        
        // Password validation
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const passwordError = document.getElementById('passwordError');
        
        // Real-time validation
        confirmPasswordInput.addEventListener('input', function() {
            if (confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
                passwordError.style.display = 'block';
                confirmPasswordInput.style.borderColor = '#dc3545';
            } else {
                passwordError.style.display = 'none';
                confirmPasswordInput.style.borderColor = '';
            }
        });
        
        // Password strength indicator (optional enhancement)
        document.getElementById('password').addEventListener('input', function() {
            const password = this.value;
            const strength = getPasswordStrength(password);
            // You can add visual feedback here
        });
        
        function getPasswordStrength(password) {
            let strength = 0;
            if (password.length >= 8) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[^A-Za-z0-9]/.test(password)) strength++;
            return strength;
        }
    </script>
</body>
</html>