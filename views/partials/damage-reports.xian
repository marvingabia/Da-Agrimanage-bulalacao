<!-- Damage Reports Section - Premium Design -->
<div class="premium-container-orange">
    <div class="premium-section-header">
        <h3 class="premium-section-title" style="color: #f59e0b;">
            <i class="fas fa-exclamation-triangle"></i>
            Crop Damage Reports
        </h3>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <span class="premium-stats-badge" id="damage-count-badge">0 Reports</span>
            {{#if (eq user.role 'farmer')}}
            <button class="premium-btn premium-btn-success" onclick="openCropScanner()" style="background:linear-gradient(135deg,#10b981,#059669); border:none; color:white; padding:0.5rem 1.1rem; border-radius:10px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:6px; font-size:0.9rem;">
                <i class="fas fa-camera"></i> Scan Crop
            </button>
            <button class="premium-btn premium-btn-danger" data-bs-toggle="modal" data-bs-target="#damageReportModal">
                <i class="fas fa-plus me-2"></i>Report Damage
            </button>
            {{/if}}
        </div>
    </div>

    <div class="premium-table-container">
        <table class="premium-table" style="--header-color-1: #f59e0b; --header-color-2: #d97706; --hover-color: #fef3c7;">
            <thead>
                <tr>
                    <th>Report ID</th>
                    <th>Farmer Name</th>
                    <th>Barangay</th>
                    <th>Incident Date</th>
                    <th>Disaster Type</th>
                    <th>Crop Type</th>
                    <th>Damage Extent</th>
                    <th>Affected Area</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="damage-reports-table">
                <tr>
                    <td colspan="10" class="premium-empty-state">
                        <i class="fas fa-exclamation-triangle" style="color: #f59e0b;"></i>
                        <p class="mb-0">No damage reports yet</p>
                        <small>Reports will appear here automatically</small>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Damage Report Modal -->
<div class="modal fade" id="damageReportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>Report Crop Damage
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="damageReportForm" onsubmit="submitDamageReport(event)">
                <div class="modal-body">
                    <!-- Farmer Information -->
                    <h6 class="mb-3 text-primary">
                        <i class="fas fa-user me-2"></i>Farmer Information
                    </h6>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name *</label>
                            <input type="text" class="form-control" name="farmerName" value="{{user.name}}" readonly>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contact Number *</label>
                            <input type="tel" class="form-control" name="contactNumber" value="{{user.phone}}" placeholder="09xxxxxxxxx" required>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Barangay *</label>
                            <select class="form-control" name="barangay" required>
                                <option value="{{user.barangay}}" selected>{{user.barangay}}</option>
                                <option value="Bagong Sikat">Bagong Sikat</option>
                                <option value="Balatasan">Balatasan</option>
                                <option value="Benli">Benli</option>
                                <option value="Cabugao">Cabugao</option>
                                <option value="Cambunang">Cambunang</option>
                                <option value="Campaasan">Campaasan</option>
                                <option value="Maasin">Maasin</option>
                                <option value="Maujao">Maujao</option>
                                <option value="Milagrosa">Milagrosa</option>
                                <option value="Nasukob">Nasukob</option>
                                <option value="Poblacion">Poblacion</option>
                                <option value="San Francisco">San Francisco</option>
                                <option value="San Isidro">San Isidro</option>
                                <option value="San Juan">San Juan</option>
                                <option value="San Roque">San Roque</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Specific Location/Sitio *</label>
                            <input type="text" class="form-control" name="location" placeholder="e.g., Sitio Maligaya" required>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Incident Details -->
                    <h6 class="mb-3 text-danger">
                        <i class="fas fa-bolt me-2"></i>Incident Details
                    </h6>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date of Incident *</label>
                            <input type="date" class="form-control" name="incidentDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Type of Disaster *</label>
                            <select class="form-control" name="disasterType" required>
                                <option value="">Select Disaster Type</option>
                                <option value="Typhoon">Typhoon</option>
                                <option value="Flood">Flood</option>
                                <option value="Drought">Drought</option>
                                <option value="Pest Infestation">Pest Infestation</option>
                                <option value="Disease Outbreak">Disease Outbreak</option>
                                <option value="Landslide">Landslide</option>
                                <option value="Fire">Fire</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Crop Damage Information -->
                    <h6 class="mb-3 text-warning">
                        <i class="fas fa-seedling me-2"></i>Crop Damage Information
                    </h6>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Crop Type *</label>
                            <select class="form-control" name="cropType" required>
                                <option value="">Select Crop Type</option>
                                <option value="Rice">Rice (Palay)</option>
                                <option value="Corn">Corn (Mais)</option>
                                <option value="Vegetables">Vegetables (Gulay)</option>
                                <option value="Coconut">Coconut (Niyog)</option>
                                <option value="Banana">Banana (Saging)</option>
                                <option value="Cassava">Cassava (Kamoteng Kahoy)</option>
                                <option value="Sweet Potato">Sweet Potato (Kamote)</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Crop Stage *</label>
                            <select class="form-control" name="cropStage" required>
                                <option value="">Select Crop Stage</option>
                                <option value="Seedling">Seedling (Binhi)</option>
                                <option value="Vegetative">Vegetative (Lumalaki)</option>
                                <option value="Flowering">Flowering (Namumulaklak)</option>
                                <option value="Fruiting">Fruiting (Namumunga)</option>
                                <option value="Mature">Mature (Hinog na)</option>
                                <option value="Ready for Harvest">Ready for Harvest (Handa nang anihin)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Affected Area (hectares) *</label>
                            <input type="number" class="form-control" name="affectedArea" step="0.01" min="0" placeholder="e.g., 2.5" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Damage Extent (%) *</label>
                            <input type="number" class="form-control" name="damagePercentage" min="0" max="100" placeholder="0-100" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Estimated Loss (₱) *</label>
                            <input type="number" class="form-control" name="estimatedLoss" min="0" placeholder="e.g., 50000" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description of Damage *</label>
                        <textarea class="form-control" name="damageDescription" rows="4" placeholder="Describe the damage to your crops in detail..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Additional Notes</label>
                        <textarea class="form-control" name="additionalNotes" rows="2" placeholder="Any additional information..."></textarea>
                    </div>

                    <!-- Evidence Images Upload -->
                    <hr class="my-4">
                    <h6 class="mb-3 text-success">
                        <i class="fas fa-camera me-2"></i>Evidence Photos <span class="text-muted fw-normal">(Optional but recommended)</span>
                    </h6>
                    <div id="evidence-upload-area" style="border:2px dashed #cbd5e1; border-radius:12px; padding:1.5rem; text-align:center; cursor:pointer; transition:all 0.3s; background:#f8fafc;"
                         onclick="document.getElementById('evidenceImagesInput').click()"
                         ondragover="event.preventDefault(); this.style.borderColor='#22c55e'; this.style.background='#f0fdf4';"
                         ondragleave="this.style.borderColor='#cbd5e1'; this.style.background='#f8fafc';"
                         ondrop="handleEvidenceDrop(event)">
                        <i class="fas fa-cloud-upload-alt" style="font-size:2rem; color:#94a3b8; display:block; margin-bottom:0.5rem;"></i>
                        <p style="margin:0; color:#64748b;">Drag & drop or <strong style="color:#22c55e;">browse photos</strong></p>
                        <p style="margin:0; color:#94a3b8; font-size:0.8rem;">JPG, PNG — max 3 photos, 3MB each</p>
                    </div>
                    <input type="file" id="evidenceImagesInput" accept="image/*" multiple style="display:none;" onchange="previewEvidenceImages(event)">
                    <div id="evidence-preview" style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:0.75rem;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-paper-plane me-2"></i>Submit Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Damage Report Modal -->
<div class="modal fade" id="viewDamageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-eye me-2"></i>Damage Report Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="viewDamageContent">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
// Load damage reports on page load
document.addEventListener('DOMContentLoaded', function() {
    // Only auto-load for staff/admin who have MySQL data to show
    // Farmers use optimistic UI — rows are added directly on submit
    const userRole = document.body.getAttribute('data-user-role') || window.USER_ROLE || '';
    if ((userRole === 'staff' || userRole === 'admin') && document.getElementById('damage-reports-table')) {
        loadDamageReports();
    }
});

function loadDamageReports() {
    const userRole = document.body.getAttribute('data-user-role') || window.USER_ROLE || 'farmer';
    const endpoint = userRole === 'farmer' ? '/api/farmer/damage-reports' : '/api/damage-reports';

    fetch(endpoint)
        .then(response => response.json())
        .then(data => {
            const tbody = document.getElementById('damage-reports-table');
            if (data.damageReports && data.damageReports.length > 0) {
                tbody.innerHTML = data.damageReports.map(report => {
                    const statusClass = report.status === 'verified' ? 'premium-badge-approved' : 
                                      report.status === 'rejected' ? 'premium-badge-rejected' : 
                                      'premium-badge-pending';
                    const statusIcon = report.status === 'verified' ? 'fa-check-circle' : 
                                     report.status === 'rejected' ? 'fa-times-circle' : 
                                     'fa-clock';
                    
                    return `
                    <tr class="animate-fade-in">
                        <td><strong>#${report.id}</strong></td>
                        <td><strong>${report.farmerName}</strong></td>
                        <td><span class="badge bg-secondary">${report.barangay}</span></td>
                        <td>${new Date(report.incidentDate).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                        })}</td>
                        <td><span class="badge bg-danger"><i class="fas fa-bolt me-1"></i>${report.disasterType}</span></td>
                        <td><span class="badge bg-success">${report.cropType}</span></td>
                        <td>
                            <div class="progress" style="height: 22px; border-radius: 10px;">
                                <div class="progress-bar ${report.damagePercentage > 75 ? 'bg-danger' : report.damagePercentage > 50 ? 'bg-warning' : 'bg-info'}" 
                                     style="width: ${report.damagePercentage}%; font-weight: 600;">
                                    ${report.damagePercentage}%
                                </div>
                            </div>
                        </td>
                        <td><strong>${report.affectedArea} ha</strong></td>
                        <td><span class="premium-badge ${statusClass}"><i class="fas ${statusIcon} me-1"></i>${report.status}</span></td>
                        <td>
                            <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:nowrap;">
                                <button onclick="viewDamageReport('${report.id}')" title="View Details"
                                    style="background:linear-gradient(135deg,#3b82f6,#2563eb); color:white; border:none; padding:0.4rem 0.75rem; border-radius:8px; font-size:0.78rem; font-weight:600; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:4px;">
                                    <i class="fas fa-eye"></i> View
                                    ${report.evidenceImages ? `<span style="background:rgba(255,255,255,0.3); font-size:0.65rem; padding:1px 4px; border-radius:6px;"><i class="fas fa-camera"></i>${(() => { try { return JSON.parse(report.evidenceImages).length; } catch(e) { return ''; } })()}</span>` : ''}
                                </button>
                                {{#if (eq user.role 'farmer')}}
                                ${report.status === 'pending' ? `
                                <button onclick="editDamageReportPhotos('${report.id}')" title="Add/Edit Photos"
                                    style="background:linear-gradient(135deg,#f59e0b,#d97706); color:white; border:none; padding:0.4rem 0.75rem; border-radius:8px; font-size:0.78rem; font-weight:600; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:4px;">
                                    <i class="fas fa-camera"></i> ${report.evidenceImages ? 'Edit Photos' : 'Add Photos'}
                                </button>` : ''}
                                {{/if}}
                                {{#if (eq user.role 'staff')}}
                                ${report.status === 'pending' ? `
                                <button onclick="verifyDamageReport('${report.id}')" title="Verify"
                                    style="background:linear-gradient(135deg,#22c55e,#16a34a); color:white; border:none; padding:0.4rem 0.75rem; border-radius:8px; font-size:0.78rem; font-weight:600; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:4px;">
                                    <i class="fas fa-check"></i> Verify
                                </button>
                                <button onclick="rejectDamageReport('${report.id}')" title="Reject"
                                    style="background:linear-gradient(135deg,#ef4444,#dc2626); color:white; border:none; padding:0.4rem 0.75rem; border-radius:8px; font-size:0.78rem; font-weight:600; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:4px;">
                                    <i class="fas fa-times"></i> Reject
                                </button>
                                ` : `<span style="font-size:0.75rem; color:#64748b; font-style:italic;">${report.status === 'verified' ? '✅ Verified' : '❌ Rejected'}</span>`}
                                {{/if}}
                                {{#if (eq user.role 'admin')}}
                                <button onclick="deleteDamageReport('${report.id}')" title="Delete"
                                    style="background:linear-gradient(135deg,#ef4444,#dc2626); color:white; border:none; padding:0.4rem 0.75rem; border-radius:8px; font-size:0.78rem; font-weight:600; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:4px;">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                `}).join('');
                
                // Update badge count
                document.getElementById('damage-count-badge').textContent = `${data.damageReports.length} Report${data.damageReports.length !== 1 ? 's' : ''}`;
                console.log(`✅ Loaded ${data.damageReports.length} damage reports from MySQL`);
            } else {
                tbody.innerHTML = '<tr><td colspan="10" class="premium-empty-state"><i class="fas fa-exclamation-triangle" style="color: #f59e0b;"></i><p class="mb-0">No damage reports yet</p><small>Reports will appear here automatically</small></td></tr>';
                document.getElementById('damage-count-badge').textContent = '0 Reports';
            }
        })
        .catch(error => {
            console.error('Error loading damage reports:', error);
            document.getElementById('damage-reports-table').innerHTML = 
                '<tr><td colspan="10" class="premium-empty-state text-danger"><i class="fas fa-exclamation-triangle"></i><p class="mb-0">Error loading data</p><small>Please refresh the page</small></td></tr>';
        });
}

// Make globally accessible for auto-refresh
window.loadDamageReports = loadDamageReports;
// Track if farmer already has optimistic rows (don't reload and wipe them)
window._damageReportsLoaded = false;

// Auto-refresh for staff/admin every 10 seconds when section is visible
(function() {
    const userRole = document.body.getAttribute('data-user-role') || window.USER_ROLE || '';
    if (userRole === 'staff' || userRole === 'admin') {
        setInterval(function() {
            const section = document.getElementById('damage-reports-section');
            if (section && section.style.display !== 'none') {
                loadDamageReports();
            }
        }, 10000);
    }
})();

// Safe load — for farmer, only load from server on first open (not after optimistic add)
window.loadDamageReportsSafe = function() {
    const userRole = document.body.getAttribute('data-user-role') || window.USER_ROLE || 'farmer';
    if (userRole === 'farmer' && window._damageReportsLoaded) {
        return; // Skip reload to preserve optimistic rows
    }
    window._damageReportsLoaded = true;
    loadDamageReports();
};

function submitDamageReport(event) {
    event.preventDefault();
    
    // Get form data FIRST (before anything else)
    const formData = new FormData(event.target);
    const data = {
        farmerName: formData.get('farmerName'),
        contactNumber: formData.get('contactNumber'),
        barangay: formData.get('barangay'),
        location: formData.get('location'),
        incidentDate: formData.get('incidentDate'),
        disasterType: formData.get('disasterType'),
        cropType: formData.get('cropType'),
        cropStage: formData.get('cropStage'),
        affectedArea: parseFloat(formData.get('affectedArea')) || 0,
        damagePercentage: parseInt(formData.get('damagePercentage')) || 0,
        estimatedLoss: parseFloat(formData.get('estimatedLoss')) || 0,
        damageDescription: formData.get('damageDescription'),
        additionalNotes: formData.get('additionalNotes'),
        evidenceImages: window._evidenceImages ? JSON.stringify(window._evidenceImages) : null
    };
    
    // Get modal reference
    const modalElement = document.getElementById('damageReportModal');
    const modal = bootstrap.Modal.getInstance(modalElement);
    
    // Close the form modal immediately and remove backdrop
    if (modal) {
        modal.hide();
    }
    
    // Force remove backdrop and restore body scroll
    setTimeout(() => {
        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('overflow');
        document.body.style.removeProperty('padding-right');
    }, 100);
    
    // Reset form and evidence images
    event.target.reset();
    window._evidenceImages = [];
    document.getElementById('evidence-preview').innerHTML = '';
    
    // Show success popup after modal is closed
    setTimeout(() => {
        showDamageSuccessPopup('Damage Report Submitted!', 'Your damage report has been submitted successfully. Staff will verify it soon.');
    }, 200);

    // Optimistically add row to table immediately (don't wait for server)
    const tempId = 'DMG-' + Date.now();
    data._tempId = tempId;
    // Mark as loaded so showSection won't reload and wipe this row
    window._damageReportsLoaded = true;
    setTimeout(() => {
        const tbody = document.getElementById('damage-reports-table');
        if (tbody) {
            // Remove empty state if present
            const emptyRow = tbody.querySelector('td.premium-empty-state');
            if (emptyRow) emptyRow.closest('tr').remove();

            const newRow = document.createElement('tr');
            newRow.id = 'row-' + tempId;
            newRow.className = 'animate-fade-in';
            newRow.innerHTML = `
                <td><strong>#${tempId}</strong></td>
                <td><strong>${data.farmerName}</strong></td>
                <td><span class="badge bg-secondary">${data.barangay}</span></td>
                <td>${new Date(data.incidentDate).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'})}</td>
                <td><span class="badge bg-danger"><i class="fas fa-bolt me-1"></i>${data.disasterType}</span></td>
                <td><span class="badge bg-success">${data.cropType}</span></td>
                <td>
                    <div class="progress" style="height:22px;border-radius:10px;">
                        <div class="progress-bar ${data.damagePercentage > 75 ? 'bg-danger' : data.damagePercentage > 50 ? 'bg-warning' : 'bg-info'}"
                             style="width:${data.damagePercentage}%;font-weight:600;">
                            ${data.damagePercentage}%
                        </div>
                    </div>
                </td>
                <td><strong>${data.affectedArea} ha</strong></td>
                <td><span class="premium-badge premium-badge-pending"><i class="fas fa-clock me-1"></i>pending</span></td>
                <td><span style="font-size:0.8rem;color:#64748b;font-style:italic;">Just submitted</span></td>
            `;
            tbody.prepend(newRow);

            // Update badge count
            const badge = document.getElementById('damage-count-badge');
            if (badge) {
                const count = tbody.querySelectorAll('tr').length;
                badge.textContent = `${count} Report${count !== 1 ? 's' : ''}`;
            }
        }
    }, 300);
    
    // Send to server in background
    fetch('/api/farmer/damage-report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            console.log('✅ Damage report saved:', result);
            // Update the "Just submitted" action cell with actual ID if returned
            if (result.damageReport && result.damageReport.id) {
                const firstRow = document.querySelector('#damage-reports-table tr:first-child td:first-child strong');
                if (firstRow && firstRow.textContent === '#DMG-' + data._tempId) {
                    firstRow.textContent = '#' + result.damageReport.id;
                }
            }
            // Update dashboard counts
            if (typeof loadDashboardData === 'function') {
                setTimeout(() => loadDashboardData(), 500);
            }
        } else {
            console.error('❌ Server error saving damage report:', result.error);
        }
    })
    .catch(error => {
        console.error('⚠️ Error saving damage report (kept in display):', error);
    });
}

function viewDamageReport(reportId) {
    fetch(`/api/damage-reports/${reportId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const report = data.damageReport;

                // Parse evidence images safely
                let evidenceImgs = [];
                if (report.evidenceImages) {
                    try { evidenceImgs = JSON.parse(report.evidenceImages); } catch(e) {}
                }
                // Store globally for lightbox
                window._viewEvidenceImgs = evidenceImgs;

                const content = `
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <span class="text-muted small">Report ID</span>
                            <div><strong>#${report.id}</strong></div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <span class="text-muted small">Status</span>
                            <div><span class="badge ${report.status === 'verified' ? 'bg-success' : report.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark'} text-uppercase">${report.status}</span></div>
                        </div>
                    </div>
                    <hr>
                    <h6 class="text-primary mb-2"><i class="fas fa-user me-1"></i>Farmer Information</h6>
                    <div class="row mb-2">
                        <div class="col-md-6 mb-1"><span class="text-muted small">Name</span><div><strong>${report.farmerName}</strong></div></div>
                        <div class="col-md-6 mb-1"><span class="text-muted small">Contact</span><div>${report.contactNumber || 'N/A'}</div></div>
                        <div class="col-md-6 mb-1"><span class="text-muted small">Barangay</span><div>${report.barangay}</div></div>
                        <div class="col-md-6 mb-1"><span class="text-muted small">Location</span><div>${report.location || 'N/A'}</div></div>
                    </div>
                    <hr>
                    <h6 class="text-danger mb-2"><i class="fas fa-bolt me-1"></i>Incident Details</h6>
                    <div class="row mb-2">
                        <div class="col-md-6 mb-1"><span class="text-muted small">Date</span><div>${new Date(report.incidentDate).toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})}</div></div>
                        <div class="col-md-6 mb-1"><span class="text-muted small">Disaster Type</span><div><span class="badge bg-danger">${report.disasterType}</span></div></div>
                    </div>
                    <hr>
                    <h6 class="text-warning mb-2"><i class="fas fa-seedling me-1"></i>Crop Damage</h6>
                    <div class="row mb-2">
                        <div class="col-md-4 mb-1"><span class="text-muted small">Crop Type</span><div>${report.cropType}</div></div>
                        <div class="col-md-4 mb-1"><span class="text-muted small">Crop Stage</span><div>${report.cropStage || 'N/A'}</div></div>
                        <div class="col-md-4 mb-1"><span class="text-muted small">Affected Area</span><div><strong>${report.affectedArea} ha</strong></div></div>
                        <div class="col-md-4 mb-1"><span class="text-muted small">Damage Extent</span><div><strong>${report.damagePercentage}%</strong></div></div>
                        <div class="col-md-4 mb-1"><span class="text-muted small">Estimated Loss</span><div><strong>₱${report.estimatedLoss ? Number(report.estimatedLoss).toLocaleString() : '0'}</strong></div></div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">Description</span>
                        <div style="background:#f8fafc; border-radius:8px; padding:0.75rem; margin-top:4px;">${report.damageDescription}</div>
                    </div>
                    ${report.additionalNotes ? `
                    <div class="mb-2">
                        <span class="text-muted small">Additional Notes</span>
                        <div style="background:#f8fafc; border-radius:8px; padding:0.75rem; margin-top:4px;">${report.additionalNotes}</div>
                    </div>` : ''}

                    ${evidenceImgs.length > 0 ? `
                    <hr>
                    <h6 class="text-success mb-2"><i class="fas fa-camera me-1"></i>Evidence Photos <span class="badge bg-success">${evidenceImgs.length}</span></h6>
                    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.5rem;">
                        ${evidenceImgs.map((img, i) => `
                            <div style="position:relative; cursor:pointer;" onclick="openEvidenceLightbox(${i})" title="Click to enlarge">
                                <img src="${img}" alt="Evidence ${i+1}"
                                    style="width:140px; height:110px; object-fit:cover; border-radius:10px; border:3px solid #22c55e; transition:transform 0.2s;"
                                    onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                <div style="position:absolute; bottom:4px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.65); color:white; font-size:0.65rem; padding:2px 8px; border-radius:6px; white-space:nowrap;">
                                    <i class="fas fa-search-plus me-1"></i>Photo ${i+1}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <p style="font-size:0.78rem; color:#64748b;"><i class="fas fa-info-circle me-1"></i>Click any photo to view full size</p>
                    ` : `
                    <hr>
                    <div style="background:#f8fafc; border-radius:10px; padding:1rem; text-align:center; color:#94a3b8;">
                        <i class="fas fa-camera" style="font-size:1.5rem; margin-bottom:0.5rem; display:block;"></i>
                        <span style="font-size:0.85rem;">No evidence photos uploaded</span>
                    </div>`}

                    ${report.verificationNotes ? `
                    <hr>
                    <div class="alert alert-info mb-0">
                        <strong><i class="fas fa-clipboard-check me-1"></i>Verification Notes:</strong>
                        <p class="mb-0 mt-1">${report.verificationNotes}</p>
                    </div>` : ''}
                `;

                document.getElementById('viewDamageContent').innerHTML = content;
                new bootstrap.Modal(document.getElementById('viewDamageModal')).show();
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showErrorPopup('Error', 'Error loading damage report details');
        });
}

// Lightbox for evidence photos
function openEvidenceLightbox(index) {
    const imgs = window._viewEvidenceImgs || [];
    if (!imgs.length) return;

    // Remove existing lightbox
    const existing = document.getElementById('evidenceLightbox');
    if (existing) existing.remove();

    const lb = document.createElement('div');
    lb.id = 'evidenceLightbox';
    lb.style.cssText = 'position:fixed; inset:0; background:rgba(0,0,0,0.92); z-index:99999; display:flex; align-items:center; justify-content:center; flex-direction:column;';
    lb.innerHTML = `
        <div style="position:relative; max-width:90vw; max-height:80vh;">
            <img id="lb-img" src="${imgs[index]}" style="max-width:90vw; max-height:75vh; border-radius:12px; object-fit:contain; box-shadow:0 20px 60px rgba(0,0,0,0.5);">
            <div style="position:absolute; top:-40px; right:0; color:white; font-size:0.9rem; opacity:0.8;">Photo <span id="lb-counter">${index+1}</span> of ${imgs.length}</div>
        </div>
        <div style="display:flex; gap:1rem; margin-top:1rem; align-items:center;">
            ${imgs.length > 1 ? `
            <button onclick="lbNav(-1)" style="background:rgba(255,255,255,0.2); color:white; border:none; width:44px; height:44px; border-radius:50%; font-size:1.2rem; cursor:pointer;">‹</button>` : ''}
            <button onclick="document.getElementById('evidenceLightbox').remove()" style="background:#ef4444; color:white; border:none; padding:0.5rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer;"><i class="fas fa-times me-1"></i>Close</button>
            ${imgs.length > 1 ? `
            <button onclick="lbNav(1)" style="background:rgba(255,255,255,0.2); color:white; border:none; width:44px; height:44px; border-radius:50%; font-size:1.2rem; cursor:pointer;">›</button>` : ''}
        </div>
    `;
    lb.addEventListener('click', function(e) { if (e.target === lb) lb.remove(); });
    document.body.appendChild(lb);
    window._lbIndex = index;
}

function lbNav(dir) {
    const imgs = window._viewEvidenceImgs || [];
    window._lbIndex = (window._lbIndex + dir + imgs.length) % imgs.length;
    document.getElementById('lb-img').src = imgs[window._lbIndex];
    document.getElementById('lb-counter').textContent = window._lbIndex + 1;
}

function verifyDamageReport(reportId) {
    if (!confirm('Are you sure you want to verify this damage report?')) {
        return;
    }
    
    const notes = prompt('Enter verification notes (optional):');
    
    fetch(`/api/staff/damage-reports/${reportId}/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            verificationNotes: notes || 'Verified by staff'
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showDamageSuccessPopup('Verified!', 'Damage report has been verified successfully.');
            loadDamageReports(); // Reload list
        } else {
            showErrorPopup('Error', data.message || 'Failed to verify damage report');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showErrorPopup('Error', 'Error verifying damage report');
    });
}

function rejectDamageReport(reportId) {
    const reason = prompt('Enter reason for rejection:');
    if (!reason) {
        alert('Rejection reason is required');
        return;
    }
    
    fetch(`/api/staff/damage-reports/${reportId}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            verificationNotes: reason
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showDamageSuccessPopup('Rejected', 'Damage report has been rejected.');
            loadDamageReports(); // Reload list
        } else {
            showErrorPopup('Error', data.message || 'Failed to reject damage report');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showErrorPopup('Error', 'Error rejecting damage report');
    });
}

// Success and Error Popup Functions
function showDamageSuccessPopup(title, message) {
    document.getElementById('damageSuccessPopupTitle').textContent = title;
    document.getElementById('damageSuccessPopupMessage').textContent = message;
    new bootstrap.Modal(document.getElementById('damageSuccessPopup')).show();
}

function showErrorPopup(title, message) {
    document.getElementById('errorPopupTitle').textContent = title;
    document.getElementById('errorPopupMessage').textContent = message;
    new bootstrap.Modal(document.getElementById('errorPopup')).show();
}

function deleteDamageReport(reportId) {
    if (!confirm('⚠️ Delete this damage report?\n\nThis action cannot be undone.')) return;
    fetch('/api/admin/delete-damage-report/' + reportId, { method: 'DELETE' })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                loadDamageReports();
                const toast = document.createElement('div');
                toast.style.cssText = 'position:fixed;bottom:2rem;right:2rem;background:#22c55e;color:white;padding:0.875rem 1.5rem;border-radius:12px;font-weight:600;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,0.2);';
                toast.innerHTML = '<i class="fas fa-check-circle me-2"></i>Damage report deleted.';
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            } else {
                alert('Error: ' + (result.error || 'Failed to delete'));
            }
        })
        .catch(err => alert('Delete failed: ' + err.message));
}

// Evidence Image Upload Functions
window._evidenceImages = [];

function previewEvidenceImages(event) {
    const files = Array.from(event.target.files);
    processEvidenceFiles(files);
}

function handleEvidenceDrop(event) {
    event.preventDefault();
    const files = Array.from(event.dataTransfer.files).filter(f => f.type.startsWith('image/'));
    processEvidenceFiles(files);
    document.getElementById('evidence-upload-area').style.borderColor = '#cbd5e1';
    document.getElementById('evidence-upload-area').style.background = '#f8fafc';
}

function processEvidenceFiles(files) {
    if (!window._evidenceImages) window._evidenceImages = [];
    const remaining = 3 - window._evidenceImages.length;
    if (remaining <= 0) { alert('Maximum 3 photos allowed.'); return; }
    const toProcess = files.slice(0, remaining);
    toProcess.forEach(file => {
        if (file.size > 3 * 1024 * 1024) { alert(`${file.name} is too large. Max 3MB per photo.`); return; }
        const reader = new FileReader();
        reader.onload = function(e) {
            window._evidenceImages.push(e.target.result);
            renderEvidencePreviews();
        };
        reader.readAsDataURL(file);
    });
}

function renderEvidencePreviews() {
    const container = document.getElementById('evidence-preview');
    if (!container) return;
    container.innerHTML = window._evidenceImages.map((img, i) => `
        <div style="position:relative; display:inline-block;">
            <img src="${img}" style="width:100px; height:80px; object-fit:cover; border-radius:8px; border:2px solid #22c55e;">
            <button type="button" onclick="removeEvidenceImage(${i})"
                style="position:absolute; top:-6px; right:-6px; width:20px; height:20px; background:#ef4444; color:white; border:none; border-radius:50%; font-size:0.7rem; cursor:pointer; line-height:1;">✕</button>
            <div style="text-align:center; font-size:0.7rem; color:#64748b; margin-top:2px;">Photo ${i+1}</div>
        </div>
    `).join('');
}

function removeEvidenceImage(index) {
    window._evidenceImages.splice(index, 1);
    renderEvidencePreviews();
}

// Edit Photos for existing damage report
function editDamageReportPhotos(reportId) {
    window._editReportId = reportId;
    window._editImages = [];

    // Load existing images first
    fetch(`/api/damage-reports/${reportId}`)
        .then(r => r.json())
        .then(data => {
            if (data.success && data.damageReport.evidenceImages) {
                try { window._editImages = JSON.parse(data.damageReport.evidenceImages); } catch(e) {}
            }
            renderEditPreviews();
            const modal = new bootstrap.Modal(document.getElementById('editPhotosModal'));
            modal.show();
        });
}

function renderEditPreviews() {
    const container = document.getElementById('edit-photos-preview');
    if (!container) return;
    if (window._editImages.length === 0) {
        container.innerHTML = '<p style="color:#94a3b8; font-size:0.85rem; text-align:center; padding:0.5rem;">No photos yet. Upload below.</p>';
        return;
    }
    container.innerHTML = window._editImages.map((img, i) => `
        <div style="position:relative; display:inline-block;">
            <img src="${img}" style="width:110px; height:85px; object-fit:cover; border-radius:8px; border:2px solid #22c55e;">
            <button type="button" onclick="removeEditImage(${i})"
                style="position:absolute; top:-6px; right:-6px; width:20px; height:20px; background:#ef4444; color:white; border:none; border-radius:50%; font-size:0.7rem; cursor:pointer; line-height:1;">✕</button>
            <div style="text-align:center; font-size:0.7rem; color:#64748b; margin-top:2px;">Photo ${i+1}</div>
        </div>
    `).join('');
}

function removeEditImage(index) {
    window._editImages.splice(index, 1);
    renderEditPreviews();
}

function handleEditPhotos(event) {
    const files = Array.from(event.target.files);
    const remaining = 5 - window._editImages.length;
    if (remaining <= 0) { alert('Maximum 5 photos allowed.'); return; }
    files.slice(0, remaining).forEach(file => {
        if (file.size > 3 * 1024 * 1024) { alert(`${file.name} too large. Max 3MB.`); return; }
        const reader = new FileReader();
        reader.onload = e => { window._editImages.push(e.target.result); renderEditPreviews(); };
        reader.readAsDataURL(file);
    });
}

function saveEditPhotos() {
    const reportId = window._editReportId;
    if (!reportId) return;

    const btn = document.getElementById('save-edit-photos-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';

    fetch(`/api/farmer/damage-report/${reportId}/photos`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ evidenceImages: JSON.stringify(window._editImages) })
    })
    .then(r => r.json())
    .then(result => {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save me-1"></i>Save Photos';
        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('editPhotosModal')).hide();
            loadDamageReports();
            const toast = document.createElement('div');
            toast.style.cssText = 'position:fixed;bottom:2rem;right:2rem;background:#22c55e;color:white;padding:0.875rem 1.5rem;border-radius:12px;font-weight:600;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,0.2);';
            toast.innerHTML = '<i class="fas fa-check-circle me-2"></i>Evidence photos updated!';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        } else {
            alert('Error: ' + (result.error || 'Failed to save photos'));
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save me-1"></i>Save Photos';
        alert('Error saving photos: ' + err.message);
    });
}
</script>

<!-- Success Popup Modal for Damage Reports -->
<!-- Edit Photos Modal -->
<div class="modal fade" id="editPhotosModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,#f59e0b,#d97706); color:white; border:none;">
                <h5 class="modal-title"><i class="fas fa-camera me-2"></i>Edit Evidence Photos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p style="font-size:0.85rem; color:#64748b; margin-bottom:1rem;">
                    <i class="fas fa-info-circle me-1 text-warning"></i>
                    You can add or remove evidence photos. Max 5 photos, 3MB each.
                </p>

                <!-- Current Photos Preview -->
                <div id="edit-photos-preview" style="display:flex; gap:0.75rem; flex-wrap:wrap; min-height:40px; margin-bottom:1rem; padding:0.5rem; background:#f8fafc; border-radius:10px;"></div>

                <!-- Upload Area -->
                <div style="border:2px dashed #f59e0b; border-radius:12px; padding:1.25rem; text-align:center; cursor:pointer; background:#fffbeb;"
                     onclick="document.getElementById('editPhotosInput').click()"
                     ondragover="event.preventDefault(); this.style.borderColor='#d97706';"
                     ondragleave="this.style.borderColor='#f59e0b';"
                     ondrop="handleEditDrop(event)">
                    <i class="fas fa-cloud-upload-alt" style="font-size:1.75rem; color:#f59e0b; display:block; margin-bottom:0.5rem;"></i>
                    <p style="margin:0; color:#92400e; font-weight:600;">Click or drag photos here</p>
                    <p style="margin:0; color:#b45309; font-size:0.78rem;">JPG, PNG — max 3MB each</p>
                </div>
                <input type="file" id="editPhotosInput" accept="image/*" multiple style="display:none;" onchange="handleEditPhotos(event)">
            </div>
            <div class="modal-footer" style="border:none; padding-top:0;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="save-edit-photos-btn" onclick="saveEditPhotos()"
                    style="background:linear-gradient(135deg,#f59e0b,#d97706); color:white; border:none; padding:0.6rem 1.5rem; border-radius:8px; font-weight:600; cursor:pointer;">
                    <i class="fas fa-save me-1"></i>Save Photos
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function handleEditDrop(event) {
    event.preventDefault();
    const files = Array.from(event.dataTransfer.files).filter(f => f.type.startsWith('image/'));
    handleEditPhotos({ target: { files } });
    event.currentTarget.style.borderColor = '#f59e0b';
}
</script>

<!-- Success Popup Modal for Damage Reports -->
<div class="modal fade" id="damageSuccessPopup" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: 20px; overflow: hidden;">
            <div class="modal-body text-center p-5" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <div class="success-icon mb-4">
                    <i class="fas fa-check-circle" style="font-size: 5rem; color: white;"></i>
                </div>
                <h3 class="text-white mb-3" id="damageSuccessPopupTitle">Success!</h3>
                <p class="text-white mb-4" id="damageSuccessPopupMessage" style="font-size: 1.1rem;">Your submission was successful.</p>
                <button type="button" class="btn btn-light btn-lg" data-bs-dismiss="modal" style="border-radius: 50px; padding: 0.75rem 2.5rem; font-weight: 600;">
                    <i class="fas fa-check me-2"></i>OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Error Popup Modal -->
<div class="modal fade" id="errorPopup" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: 20px; overflow: hidden;">
            <div class="modal-body text-center p-5" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <div class="error-icon mb-4">
                    <i class="fas fa-exclamation-circle" style="font-size: 5rem; color: white;"></i>
                </div>
                <h3 class="text-white mb-3" id="errorPopupTitle">Error!</h3>
                <p class="text-white mb-4" id="errorPopupMessage" style="font-size: 1.1rem;">Something went wrong.</p>
                <button type="button" class="btn btn-light btn-lg" data-bs-dismiss="modal" style="border-radius: 50px; padding: 0.75rem 2.5rem; font-weight: 600;">
                    <i class="fas fa-times me-2"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.success-icon i, .error-icon i {
    animation: scaleIn 0.5s ease-out;
}

@keyframes scaleIn {
    0% {
        transform: scale(0);
        opacity: 0;
    }
    50% {
        transform: scale(1.1);
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}
</style>

<!-- ═══════════════════════════════════════════════════════════════
     CROP SCANNER MODAL — Camera + AI Identification + GPS Mapping
     Uses: TensorFlow.js (MobileNet) for crop analysis,
           Leaflet.js for free map, Browser Geolocation API
════════════════════════════════════════════════════════════════ -->

<!-- Leaflet CSS for the map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>

<div id="cropScannerModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.82); z-index:10500; align-items:center; justify-content:center; overflow-y:auto; padding:1rem;">
    <div style="background:white; border-radius:20px; width:95%; max-width:700px; box-shadow:0 25px 80px rgba(0,0,0,0.4); overflow:hidden; position:relative; margin:auto;">

        <!-- Header -->
        <div style="background:linear-gradient(135deg,#059669,#10b981); padding:1.25rem 1.5rem; display:flex; align-items:center; justify-content:space-between;">
            <div style="flex:1;">
                <h5 style="color:white; margin:0; font-weight:700; font-size:1.1rem;">
                    <i class="fas fa-camera me-2"></i>Crop Scanner & AI Analysis
                </h5>
                <small style="color:rgba(255,255,255,0.8);">Kumuha ng larawan para matukoy ang problema sa inyong taniman</small>
            </div>
            <div style="display:flex; gap:0.5rem; align-items:center;">
                <button onclick="testGoogleVisionAPI()" style="background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.3); padding:0.4rem 0.75rem; border-radius:8px; color:white; font-size:0.75rem; cursor:pointer; font-weight:600; white-space:nowrap;">
                    <i class="fas fa-flask me-1"></i>Test API
                </button>
                <button onclick="closeCropScanner()" style="background:rgba(255,255,255,0.2); border:none; width:34px; height:34px; border-radius:50%; color:white; font-size:1.1rem; cursor:pointer; display:flex; align-items:center; justify-content:center;">&times;</button>
            </div>
        </div>

        <div style="padding:1.5rem;">

            <!-- STEP 1: Camera / Upload -->
            <div id="scanner-step-1">
                <div style="display:flex; gap:0.75rem; margin-bottom:1rem; flex-wrap:wrap;">
                    <button onclick="startCamera()" id="btn-start-cam"
                        style="flex:1; min-width:130px; background:linear-gradient(135deg,#3b82f6,#2563eb); color:white; border:none; padding:0.75rem 1rem; border-radius:12px; font-weight:600; cursor:pointer; font-size:0.9rem;">
                        <i class="fas fa-video me-1"></i>Open Camera
                    </button>
                    <button onclick="document.getElementById('cropFileInput').click()"
                        style="flex:1; min-width:130px; background:linear-gradient(135deg,#8b5cf6,#7c3aed); color:white; border:none; padding:0.75rem 1rem; border-radius:12px; font-weight:600; cursor:pointer; font-size:0.9rem;">
                        <i class="fas fa-image me-1"></i>Upload Photo
                    </button>
                    <button onclick="getGPSLocation()" id="btn-get-gps"
                        style="flex:1; min-width:130px; background:linear-gradient(135deg,#f59e0b,#d97706); color:white; border:none; padding:0.75rem 1rem; border-radius:12px; font-weight:600; cursor:pointer; font-size:0.9rem;">
                        <i class="fas fa-map-marker-alt me-1"></i>Get Location
                    </button>
                </div>
                <input type="file" id="cropFileInput" accept="image/*" style="display:none;" onchange="handleCropFileUpload(event)">

                <!-- Camera Feed -->
                <div id="camera-container" style="display:none; margin-bottom:1rem;">
                    <video id="crop-video" autoplay playsinline muted
                        style="width:100%; border-radius:12px; background:#000; max-height:320px; object-fit:cover;"></video>
                    <div style="display:flex; gap:0.75rem; margin-top:0.75rem; justify-content:center;">
                        <button onclick="capturePhoto()"
                            style="background:linear-gradient(135deg,#ef4444,#dc2626); color:white; border:none; padding:0.75rem 2rem; border-radius:50px; font-weight:700; cursor:pointer; font-size:1rem;">
                            <i class="fas fa-camera me-2"></i>Capture Photo
                        </button>
                        <button onclick="stopCamera()"
                            style="background:#64748b; color:white; border:none; padding:0.75rem 1.25rem; border-radius:50px; font-weight:600; cursor:pointer;">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                    </div>
                </div>

                <!-- Preview Canvas (hidden, used for capture) -->
                <canvas id="crop-canvas" style="display:none;"></canvas>

                <!-- Captured Image Preview -->
                <div id="captured-preview-area" style="display:none; margin-bottom:1rem;">
                    <img id="captured-img" style="width:100%; border-radius:12px; max-height:280px; object-fit:cover; border:3px solid #10b981;" alt="Captured crop photo">
                    <div style="text-align:center; margin-top:0.5rem;">
                        <button onclick="analyzeImage()"
                            style="background:linear-gradient(135deg,#059669,#10b981); color:white; border:none; padding:0.75rem 2rem; border-radius:50px; font-weight:700; cursor:pointer; font-size:0.95rem;">
                            <i class="fas fa-brain me-2"></i>Analyze with AI
                        </button>
                        <button onclick="retakePhoto()" style="background:#f1f5f9; color:#374151; border:none; padding:0.75rem 1.25rem; border-radius:50px; font-weight:600; cursor:pointer; margin-left:0.5rem;">
                            <i class="fas fa-redo me-1"></i>Retake
                        </button>
                    </div>
                </div>
            </div>

            <!-- AI Analysis Loading -->
            <div id="scanner-loading" style="display:none; text-align:center; padding:2rem 0;">
                <div style="display:inline-block; width:56px; height:56px; border:5px solid #d1fae5; border-top-color:#059669; border-radius:50%; animation:spin 0.9s linear infinite; margin-bottom:1rem;"></div>
                <p style="color:#059669; font-weight:700; font-size:1rem; margin:0;">Sinusuri ng AI ang larawan...</p>
                <small style="color:#64748b;">Analyzing crop health, please wait</small>
            </div>

            <!-- AI Analysis Results -->
            <div id="scanner-results" style="display:none; margin-bottom:1.25rem;">
                <div style="background:linear-gradient(135deg,#f0fdf4,#dcfce7); border-radius:14px; padding:1.25rem; border:2px solid #86efac; margin-bottom:1rem;">
                    <h6 style="color:#166534; font-weight:700; margin-bottom:0.75rem;">
                        <i class="fas fa-robot me-2"></i>AI Analysis Results
                    </h6>

                    <!-- Detected Condition -->
                    <div style="display:flex; align-items:flex-start; gap:0.75rem; margin-bottom:0.75rem;">
                        <div id="ai-condition-icon" style="width:44px; height:44px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.3rem; flex-shrink:0; background:#fee2e2;">⚠️</div>
                        <div style="flex:1;">
                            <div style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase;">Detected Condition</div>
                            <div id="ai-condition-name" style="font-size:1rem; font-weight:700; color:#1e293b;">Analyzing...</div>
                            <div id="ai-condition-conf" style="font-size:0.8rem; color:#059669; font-weight:600;"></div>
                        </div>
                    </div>

                    <!-- Recommendations -->
                    <div style="background:white; border-radius:10px; padding:0.875rem; margin-bottom:0.75rem;">
                        <div style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase; margin-bottom:0.5rem;">
                            <i class="fas fa-lightbulb me-1 text-warning"></i>Rekomendasyon
                        </div>
                        <div id="ai-recommendation" style="font-size:0.88rem; color:#374151; line-height:1.6;">—</div>
                    </div>

                    <!-- Suggested form values -->
                    <div style="background:white; border-radius:10px; padding:0.875rem;">
                        <div style="font-size:0.75rem; color:#64748b; font-weight:600; text-transform:uppercase; margin-bottom:0.5rem;">
                            <i class="fas fa-clipboard-list me-1 text-primary"></i>Suggested Report Values
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; font-size:0.85rem;">
                            <div><span style="color:#94a3b8;">Disaster Type:</span> <strong id="sug-disaster">—</strong></div>
                            <div><span style="color:#94a3b8;">Crop Type:</span> <strong id="sug-crop">—</strong></div>
                            <div><span style="color:#94a3b8;">Damage %:</span> <strong id="sug-damage">—</strong></div>
                            <div><span style="color:#94a3b8;">Severity:</span> <strong id="sug-severity">—</strong></div>
                        </div>
                    </div>
                </div>

                <!-- GPS & Map Section -->
                <div style="background:linear-gradient(135deg,#eff6ff,#dbeafe); border-radius:14px; padding:1.25rem; border:2px solid #93c5fd;">
                    <h6 style="color:#1e40af; font-weight:700; margin-bottom:0.75rem;">
                        <i class="fas fa-map-marked-alt me-2"></i>Farm Location Map
                    </h6>
                    <div id="gps-status" style="font-size:0.85rem; color:#475569; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.5rem;">
                        <i class="fas fa-info-circle text-primary"></i>
                        <span id="gps-status-text">Click "Get Location" to show your farm on the map</span>
                    </div>
                    <div id="scanner-map" style="height:220px; border-radius:12px; border:2px solid #93c5fd; overflow:hidden; background:#e2e8f0; display:flex; align-items:center; justify-content:center;">
                        <div style="text-align:center; color:#94a3b8; padding:1rem;">
                            <i class="fas fa-map" style="font-size:2rem; margin-bottom:0.5rem; display:block;"></i>
                            <span style="font-size:0.85rem;">Map will appear after getting location</span>
                        </div>
                    </div>
                    <div id="gps-coords" style="margin-top:0.5rem; font-size:0.78rem; color:#64748b; display:none;">
                        📍 Coordinates: <strong id="gps-lat">—</strong>, <strong id="gps-lng">—</strong>
                        &nbsp;|&nbsp; Accuracy: <strong id="gps-accuracy">—</strong>m
                    </div>
                </div>

                <!-- Use Results Button -->
                <div style="text-align:center; margin-top:1.25rem;">
                    <button onclick="fillReportFromScan()"
                        style="background:linear-gradient(135deg,#f59e0b,#d97706); color:white; border:none; padding:0.875rem 2.5rem; border-radius:50px; font-weight:700; cursor:pointer; font-size:1rem; box-shadow:0 4px 15px rgba(245,158,11,0.4);">
                        <i class="fas fa-file-alt me-2"></i>Use Results to Fill Report
                    </button>
                    <button onclick="closeCropScanner()" style="background:#f1f5f9; color:#374151; border:none; padding:0.875rem 1.5rem; border-radius:50px; font-weight:600; cursor:pointer; margin-left:0.75rem;">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS for map -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
#cropScannerModal { display: none; }
#cropScannerModal.active { display: flex; }
</style>

<script>
// ══════════════════════════════════════════════
//  CROP SCANNER — State Variables
// ══════════════════════════════════════════════
let _cropStream = null;
let _cropMap = null;
let _cropMarker = null;
let _capturedDataUrl = null;
let _scanGPS = null; // { lat, lng, accuracy }
let _aiResult = null; // Final AI suggestion object

// ══════════════════════════════════════════════
//  Open / Close
// ══════════════════════════════════════════════
function openCropScanner() {
    document.getElementById('cropScannerModal').classList.add('active');
    document.getElementById('cropScannerModal').style.display = 'flex';
    resetScanner();
    // Auto-request GPS when scanner opens
    getGPSLocation();
}

function closeCropScanner() {
    stopCamera();
    document.getElementById('cropScannerModal').style.display = 'none';
    document.getElementById('cropScannerModal').classList.remove('active');
    if (_cropMap) { _cropMap.remove(); _cropMap = null; _cropMarker = null; }
}

function resetScanner() {
    document.getElementById('camera-container').style.display = 'none';
    document.getElementById('captured-preview-area').style.display = 'none';
    document.getElementById('scanner-loading').style.display = 'none';
    document.getElementById('scanner-results').style.display = 'none';
    document.getElementById('scanner-step-1').style.display = 'block';
    hideCameraError();
    _capturedDataUrl = null;
    _aiResult = null;
}

// ══════════════════════════════════════════════
//  Camera Controls
// ══════════════════════════════════════════════
async function startCamera() {
    const btn = document.getElementById('btn-start-cam');
    const video = document.getElementById('crop-video');
    const container = document.getElementById('camera-container');

    // Show loading state on button
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Starting...'; }

    // Check if mediaDevices API is available
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        showCameraError('Camera API not available. Make sure you are using Chrome/Edge/Firefox and the page is loaded from localhost or https.');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-video me-1"></i>Open Camera'; }
        return;
    }

    // Strategy: try back camera first (mobile), fall back to any camera (desktop/laptop)
    const tryConstraints = [
        // 1st try: back camera at good resolution (mobile)
        { video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 }, height: { ideal: 720 } } },
        // 2nd try: any camera, exact resolution
        { video: { width: { ideal: 1280 }, height: { ideal: 720 } } },
        // 3rd try: minimal — just any video device (desktop webcam)
        { video: true }
    ];

    let stream = null;
    let lastError = null;

    for (const constraints of tryConstraints) {
        try {
            stream = await navigator.mediaDevices.getUserMedia(constraints);
            break; // success — stop trying
        } catch (err) {
            lastError = err;
            console.warn('Camera attempt failed with constraints:', constraints, '— Error:', err.name, err.message);
        }
    }

    if (!stream) {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-video me-1"></i>Open Camera'; }

        // Give a specific, helpful message based on error type
        let msg = '';
        if (lastError && lastError.name === 'NotAllowedError') {
            msg = '🔒 Camera access was denied.\n\n'
                + 'To fix this:\n'
                + '1. Click the 🔒 or 📷 icon in your browser address bar\n'
                + '2. Set Camera permission to "Allow"\n'
                + '3. Refresh the page and try again\n\n'
                + 'Or use "Upload Photo" to select an image from your device.';
        } else if (lastError && lastError.name === 'NotFoundError') {
            msg = '📷 No camera found on this device.\n\nUse "Upload Photo" to select an image from your computer.';
        } else if (lastError && lastError.name === 'NotReadableError') {
            msg = '⚠️ Camera is already in use by another app.\n\nClose other apps using the camera (e.g. Zoom, Teams) and try again.';
        } else {
            msg = '❌ Could not start camera: ' + (lastError ? lastError.message : 'Unknown error') + '\n\nUse "Upload Photo" instead.';
        }

        showCameraError(msg);
        return;
    }

    _cropStream = stream;
    video.srcObject = stream;
    try { await video.play(); } catch(e) { /* autoplay may be blocked — ok */ }

    container.style.display = 'block';
    document.getElementById('captured-preview-area').style.display = 'none';
    hideCameraError();

    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-video me-1"></i>Open Camera'; }
}

function showCameraError(msg) {
    let el = document.getElementById('camera-error-box');
    if (!el) {
        el = document.createElement('div');
        el.id = 'camera-error-box';
        el.style.cssText = 'background:#fef2f2; border:2px solid #fca5a5; border-radius:12px; padding:1rem 1.25rem; margin-bottom:1rem; color:#7f1d1d; font-size:0.88rem; white-space:pre-line; line-height:1.6;';
        // Insert before scanner-step-1 buttons
        const step1 = document.getElementById('scanner-step-1');
        if (step1) step1.insertBefore(el, step1.firstChild);
    }
    el.innerHTML = '<i class="fas fa-exclamation-triangle me-2" style="color:#ef4444;"></i>' + msg.replace(/\n/g, '<br>');
    el.style.display = 'block';
}

function hideCameraError() {
    const el = document.getElementById('camera-error-box');
    if (el) el.style.display = 'none';
}

function stopCamera() {
    if (_cropStream) {
        _cropStream.getTracks().forEach(t => t.stop());
        _cropStream = null;
    }
    document.getElementById('camera-container').style.display = 'none';
}

function capturePhoto() {
    const video = document.getElementById('crop-video');
    const canvas = document.getElementById('crop-canvas');
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;
    canvas.getContext('2d').drawImage(video, 0, 0);
    _capturedDataUrl = canvas.toDataURL('image/jpeg', 0.85);
    
    // Clear previous AI results - new photo needs new analysis
    _aiResult = null;
    document.getElementById('scanner-results').style.display = 'none';
    
    stopCamera();
    showCapturedPreview(_capturedDataUrl);
}

function handleCropFileUpload(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    // Clear previous results
    _aiResult = null;
    document.getElementById('scanner-results').style.display = 'none';
    
    const reader = new FileReader();
    reader.onload = e => { 
        _capturedDataUrl = e.target.result; 
        showCapturedPreview(_capturedDataUrl); 
    };
    reader.readAsDataURL(file);
}

function showCapturedPreview(dataUrl) {
    document.getElementById('captured-img').src = dataUrl;
    document.getElementById('captured-preview-area').style.display = 'block';
    document.getElementById('camera-container').style.display = 'none';
    
    // Hide old results - new image needs new analysis
    document.getElementById('scanner-results').style.display = 'none';
    _aiResult = null;
}

function retakePhoto() {
    document.getElementById('captured-preview-area').style.display = 'none';
    document.getElementById('scanner-results').style.display = 'none';
    _capturedDataUrl = null;
    _aiResult = null;
}

// ══════════════════════════════════════════════
//  GPS Location
// ══════════════════════════════════════════════
function getGPSLocation() {
    const btn = document.getElementById('btn-get-gps');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Getting...'; }

    if (!navigator.geolocation) {
        document.getElementById('gps-status-text').textContent = '❌ Ang browser mo ay hindi sumusuporta sa GPS.';
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-map-marker-alt me-1"></i>Get Location'; }
        return;
    }

    document.getElementById('gps-status-text').textContent = '📡 Kukunin ang iyong lokasyon...';

    navigator.geolocation.getCurrentPosition(
        pos => {
            _scanGPS = { lat: pos.coords.latitude, lng: pos.coords.longitude, accuracy: Math.round(pos.coords.accuracy) };
            document.getElementById('gps-status-text').textContent = '✅ Nakuha na ang lokasyon!';
            document.getElementById('gps-coords').style.display = 'block';
            document.getElementById('gps-lat').textContent = _scanGPS.lat.toFixed(6);
            document.getElementById('gps-lng').textContent = _scanGPS.lng.toFixed(6);
            document.getElementById('gps-accuracy').textContent = _scanGPS.accuracy;
            if (btn) { btn.disabled = false; btn.innerHTML = '✅ Location Set'; btn.style.background = 'linear-gradient(135deg,#22c55e,#16a34a)'; }
            // Show map immediately in results area if it's visible, else store for later
            renderMap(_scanGPS.lat, _scanGPS.lng);
        },
        err => {
            let msg = 'Hindi nakuha ang GPS. ';
            if (err.code === 1) msg += 'Ipahintulot ang location access sa browser.';
            else if (err.code === 2) msg += 'GPS signal hindi available.';
            else msg += 'Subukang muli.';
            document.getElementById('gps-status-text').textContent = '⚠️ ' + msg;
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-map-marker-alt me-1"></i>Retry Location'; }
        },
        { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
    );
}

function renderMap(lat, lng) {
    const mapEl = document.getElementById('scanner-map');
    // Clear placeholder content
    mapEl.innerHTML = '';

    // Destroy old map instance if any
    if (_cropMap) { _cropMap.remove(); _cropMap = null; _cropMarker = null; }

    // Small delay to ensure el is visible and has dimensions
    setTimeout(() => {
        _cropMap = L.map('scanner-map', { zoomControl: true, attributionControl: false }).setView([lat, lng], 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(_cropMap);

        // Custom farm marker
        const farmIcon = L.divIcon({
            html: `<div style="background:#059669;width:32px;height:32px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 3px 10px rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;">
                       <i class="fas fa-seedling" style="transform:rotate(45deg); color:white; font-size:14px; display:block; text-align:center; line-height:26px;"></i>
                   </div>`,
            className: '',
            iconSize: [32, 42],
            iconAnchor: [16, 42],
            popupAnchor: [0, -42]
        });

        _cropMarker = L.marker([lat, lng], { icon: farmIcon })
            .addTo(_cropMap)
            .bindPopup(`<b>📍 Inyong Taniman</b><br>Lat: ${lat.toFixed(5)}, Lng: ${lng.toFixed(5)}<br><small>Accuracy: ~${_scanGPS?.accuracy || '?'}m</small>`)
            .openPopup();

        // Accuracy circle
        L.circle([lat, lng], { color: '#059669', fillColor: '#d1fae5', fillOpacity: 0.25, radius: _scanGPS?.accuracy || 20 }).addTo(_cropMap);

        // Invalidate size after render
        setTimeout(() => _cropMap.invalidateSize(), 100);
    }, 100);
}

// ══════════════════════════════════════════════
//  AI Crop Analysis — Rule-based + Visual Heuristics
//  (Works fully offline — no API key needed)
// ══════════════════════════════════════════════

// Comprehensive agricultural disease/damage pattern library
const CROP_CONDITIONS = [
    // ═══ TOMATO CONDITIONS ═══
    {
        id: 'tomato-blight',
        name: 'Tomato Blight (Late Blight ng Kamatis)',
        disasterType: 'Disease Outbreak',
        cropType: 'Tomato',
        damageMin: 45, damageMax: 80,
        severity: 'High',
        description: 'May Late Blight ang inyong kamatis. Makikita ang mga dark brown/black spots sa dahon at prutas, at may white mold sa ilalim ng dahon.',
        recommendation: 'Mag-apply ng fungicide (copper-based o chlorothalonil). Alisin at sunugin ang mga apektadong dahon. Iwasan ang overhead watering. Siguraduhing may ventilation ang plants.',
        keywords: ['tomato', 'kamatis', 'dark', 'black', 'spot', 'brown'],
        colorHints: { highRed: true, brownPatches: true, darkSpots: true }
    },
    {
        id: 'tomato-bacterial-spot',
        name: 'Bacterial Spot sa Kamatis',
        disasterType: 'Disease Outbreak',
        cropType: 'Tomato',
        damageMin: 35, damageMax: 65,
        severity: 'Medium',
        description: 'May Bacterial Spot ang kamatis. Makikita ang maliliit na dark brown/black spots na may yellow halo sa paligid.',
        recommendation: 'Mag-apply ng copper-based bactericide. Alisin ang apektadong dahon. Iwasan ang pagdikit ng tubig sa dahon kapag nag-iirrigate.',
        keywords: ['tomato', 'kamatis', 'spot', 'dark', 'bacterial'],
        colorHints: { highRed: true, brownPatches: true, yellowRing: true }
    },
    {
        id: 'tomato-pest',
        name: 'Tomato Fruitworm/Pest Damage',
        disasterType: 'Pest Infestation',
        cropType: 'Tomato',
        damageMin: 30, damageMax: 70,
        severity: 'Medium',
        description: 'May pest infestation (fruitworm, aphids, o whiteflies) sa kamatis. Makikita ang mga butas, nakakaing bahagi, o deformed fruits.',
        recommendation: 'Mag-apply ng insecticide (BT o spinosad para sa fruitworms). Gumamit ng sticky traps para sa whiteflies. Regular na inspeksyon at manual removal ng pests.',
        keywords: ['tomato', 'kamatis', 'holes', 'eaten', 'pest', 'insects'],
        colorHints: { highRed: true, darkAreas: true }
    },
    {
        id: 'tomato-sunscald',
        name: 'Sunscald sa Kamatis',
        disasterType: 'Environmental Stress',
        cropType: 'Tomato',
        damageMin: 20, damageMax: 50,
        severity: 'Medium',
        description: 'May sunscald ang prutas ng kamatis. Makikita ang white o yellow patches na nagiging wrinkled at brown.',
        recommendation: 'Maglagay ng shade cloth sa init ng tanghali. Siguraduhing may sapat na dahon para protektahan ang prutas. Iwasan ang sobrang pruning.',
        keywords: ['tomato', 'kamatis', 'white', 'yellow', 'sunscald'],
        colorHints: { highRed: true, whitePatches: true, yellowPatches: true }
    },
    {
        id: 'tomato-healthy',
        name: 'Healthy Tomato Plants (Malusog na Kamatis)',
        disasterType: null,
        cropType: 'Tomato',
        damageMin: 0, damageMax: 10,
        severity: 'None',
        description: 'Ang inyong kamatis ay mukhang malusog. Maganda ang kulay ng prutas at dahon.',
        recommendation: 'Ipagpatuloy ang regular na pag-aalaga. I-monitor ang tubig at fertilizer. Regular na inspeksyon para sa early detection ng sakit.',
        keywords: ['tomato', 'kamatis', 'healthy', 'red', 'green'],
        colorHints: { highRed: true, moderateGreen: true }
    },
    
    // ═══ RICE CONDITIONS ═══
    {
        id: 'blast',
        name: 'Rice Blast (Blast ng Palay)',
        disasterType: 'Disease Outbreak',
        cropType: 'Rice',
        damageMin: 40, damageMax: 75,
        severity: 'High',
        description: 'Posibleng may Rice Blast ang inyong palay. Nakikita ang mga brown/gray na spots sa dahon o sa butil.',
