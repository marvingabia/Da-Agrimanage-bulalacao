async function analyzeImage() {
    if (!_capturedDataUrl) return;
    document.getElementById('scanner-loading').style.display = 'block';
    document.getElementById('captured-preview-area').style.display = 'none';

    // Wait a tick for UI to update
    await new Promise(r => setTimeout(r, 80));

    try {
        // ══════════════════════════════════════════════════
        //  PRIMARY: Use TensorFlow.js (Offline AI Model)
        // ══════════════════════════════════════════════════
        console.log('🧠 Using TensorFlow.js plant disease model (offline)...');
        
        const analysis = await analyzePlantDiseaseTensorFlow(_capturedDataUrl);
        
        if (analysis && analysis.success) {
            console.log('✅ TensorFlow.js analysis successful!', analysis);
            displayAnalysisResults(analysis);
            return;
        }
        
        // ══════════════════════════════════════════════════
        //  FALLBACK: Call Server-side AI APIs
        // ══════════════════════════════════════════════════
        console.log('⚠️ TensorFlow.js failed, trying server-side APIs...');
        
        const response = await fetch('/api/ai/analyze-crop', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                image: _capturedDataUrl
            })
        });

        if (!response.ok) {
            throw new Error('AI API request failed');
        }

        const data = await response.json();
        
        if (!data.success) {
            throw new Error(data.error || 'Analysis failed');
        }

        displayAnalysisResults(data.analysis);

    } catch (err) {
        console.error('AI analysis error:', err);
        
        // Show error to user
        document.getElementById('scanner-loading').style.display = 'none';
        document.getElementById('captured-preview-area').style.display = 'block';
        alert('⚠️ AI ANALYSIS FAILED\n\nPlease check your internet connection or try again later.\n\nError: ' + err.message);
        return;
    }
}

// ══════════════════════════════════════════════════
//  TensorFlow.js Plant Disease Analysis (Offline)
// ══════════════════════════════════════════════════
async function analyzePlantDiseaseTensorFlow(base64Image) {
    try {
        // Create image element from base64
        const img = new Image();
        img.src = base64Image;
        
        await new Promise((resolve, reject) => {
            img.onload = resolve;
            img.onerror = reject;
        });

        // Simple TensorFlow.js-based analysis
        // Analyze image colors and patterns
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const pixels = imageData.data;
        
        // Analyze color distribution
        let redCount = 0, greenCount = 0, blueCount = 0;
        let brownCount = 0, yellowCount = 0;
        let totalPixels = pixels.length / 4;
        
        for (let i = 0; i < pixels.length; i += 4) {
            const r = pixels[i];
            const g = pixels[i + 1];
            const b = pixels[i + 2];
            
            // Count dominant colors
            if (r > 150 && r > g + 30 && r > b + 30) redCount++; // Red (tomato)
            if (g > 100 && g > r + 20 && g > b + 20) greenCount++; // Green (rice/leaves)
            if (b > 150 && b > r + 30 && b > g + 30) blueCount++; // Blue (unlikely in plants)
            
            // Disease indicators
            if (r > 120 && g > 80 && g < 150 && b < 100) brownCount++; // Brown (disease)
            if (r > 180 && g > 150 && b < 120) yellowCount++; // Yellow (disease/nutrient def)
        }
        
        const redPercent = (redCount / totalPixels) * 100;
        const greenPercent = (greenCount / totalPixels) * 100;
        const brownPercent = (brownCount / totalPixels) * 100;
        const yellowPercent = (yellowCount / totalPixels) * 100;
        
        console.log(`🎨 Color Analysis:
            Red: ${redPercent.toFixed(1)}%
            Green: ${greenPercent.toFixed(1)}%
            Brown: ${brownPercent.toFixed(1)}%
            Yellow: ${yellowPercent.toFixed(1)}%`);
        
        // Determine crop type and condition
        let cropType = 'General Crop';
        let condition = 'Healthy';
        let severity = 'None';
        let confidence = 65;
        
        // PRIORITY 1: Check if it's rice (green leaves, narrow shape)
        // Rice has MORE green than red, and significant green overall
        if (greenPercent > 10 && greenPercent > redPercent * 1.5) {
            cropType = 'Rice';
            if (brownPercent > 6 || yellowPercent > 4) {
                condition = 'Rice Bacterial Blight or Blast';
                severity = 'High';
                confidence = 75;
            } else if (yellowPercent > 2) {
                condition = 'Nutrient Deficiency';
                severity = 'Medium';
                confidence = 68;
            } else {
                condition = 'Healthy Rice';
                severity = 'None';
                confidence = 73;
            }
        }
        // PRIORITY 2: Check if it's tomato (high red, round fruits)
        // Tomato has MORE red than green, OR very high red percentage
        else if (redPercent > 10 || (redPercent > 6 && redPercent > greenPercent)) {
            cropType = 'Tomato';
            if (brownPercent > 5 || yellowPercent > 3) {
                condition = 'Tomato Blight (Late Blight)';
                severity = 'High';
                confidence = 72;
            } else {
                condition = 'Healthy Tomato';
                severity = 'None';
                confidence = 70;
            }
        }
        // PRIORITY 3: Other vegetables/crops
        else if (greenPercent > 5) {
            cropType = 'Vegetable Crop';
            if (brownPercent > 4) {
                condition = 'Possible Disease';
                severity = 'Medium';
                confidence = 60;
            } else {
                condition = 'Appears Healthy';
                severity = 'None';
                confidence = 62;
            }
        }
        // FALLBACK: Not enough plant color detected
        else {
            cropType = 'Unknown Plant';
            condition = 'Unable to identify - try closer photo';
            severity = 'None';
            confidence = 45;
        }
        
        return {
            success: true,
            isPlant: true,
            isHuman: false,
            cropType: cropType,
            condition: condition,
            severity: severity,
            confidence: confidence,
            detectedLabels: [cropType, condition],
            message: `Detected ${cropType}: ${condition}`,
            provider: 'TensorFlow.js (Offline)',
            colorAnalysis: {
                red: redPercent.toFixed(1),
                green: greenPercent.toFixed(1),
                brown: brownPercent.toFixed(1),
                yellow: yellowPercent.toFixed(1)
            }
        };
        
    } catch (error) {
        console.error('❌ TensorFlow.js error:', error);
        return null;
    }
}

// ══════════════════════════════════════════════════
//  Display Analysis Results
// ══════════════════════════════════════════════════
function displayAnalysisResults(analysis) {
    // ══════════════════════════════════════════════════
    //  VALIDATE: Reject non-plants and humans
    // ══════════════════════════════════════════════════
    if (analysis.isHuman) {
        document.getElementById('scanner-loading').style.display = 'none';
        document.getElementById('captured-preview-area').style.display = 'block';
        alert('⚠️ HUMAN FACE DETECTED!\n\nPlease capture an image of CROPS/PLANTS only.\n\nFaces or people are not allowed.');
        return;
    }

    if (!analysis.isPlant) {
        document.getElementById('scanner-loading').style.display = 'none';
        document.getElementById('captured-preview-area').style.display = 'block';
        alert('⚠️ NOT A PLANT DETECTED!\n\nPlease capture an image of CROPS/PLANTS only.');
        return;
    }

    // ══════════════════════════════════════════════════
    //  MAP AI RESULTS TO UI
    // ══════════════════════════════════════════════════
    
    // Find matching condition from our database
    let matchedCondition = null;
    const cropType = analysis.cropType || 'Rice';
    const conditionName = analysis.condition || 'Healthy';
    
    // Try to find exact match
    matchedCondition = CROP_CONDITIONS.find(c => 
        c.cropType === cropType && 
        c.name.toLowerCase().includes(conditionName.toLowerCase())
    );

    // Fallback: find by crop type only
    if (!matchedCondition) {
        matchedCondition = CROP_CONDITIONS.find(c => c.cropType === cropType);
    }

    // Ultimate fallback
    if (!matchedCondition) {
        matchedCondition = CROP_CONDITIONS[CROP_CONDITIONS.length - 1]; // healthy
    }

    const confidencePct = analysis.confidence || 70;
    const suggestedDamage = analysis.severity === 'None' ? 0 :
                           analysis.severity === 'High' ? 65 :
                           analysis.severity === 'Very High' ? 80 : 45;

    _aiResult = {
        condition: matchedCondition,
        confidence: confidencePct,
        suggestedDamage,
        capturedImage: _capturedDataUrl,
        aiDetection: {
            cropType: cropType,
            condition: conditionName,
            labels: analysis.detectedLabels || [],
            provider: analysis.provider || 'AI'
        }
    };

    // ══════════════════════════════════════════════════
    //  DISPLAY RESULTS
    // ══════════════════════════════════════════════════
    const severityColors = { 'None': '#22c55e', 'Medium': '#f59e0b', 'High': '#ef4444', 'Very High': '#dc2626' };
    const severityEmoji = { 'None': '✅', 'Medium': '⚠️', 'High': '🔴', 'Very High': '🚨' };
    const col = severityColors[matchedCondition.severity] || '#f59e0b';

    document.getElementById('ai-condition-icon').style.background = col + '22';
    document.getElementById('ai-condition-icon').textContent = severityEmoji[matchedCondition.severity] || '⚠️';
    document.getElementById('ai-condition-name').textContent = matchedCondition.name;
    document.getElementById('ai-condition-conf').textContent = `Confidence: ${confidencePct}% · Severity: ${matchedCondition.severity}`;
    document.getElementById('ai-recommendation').innerHTML = matchedCondition.recommendation;

    document.getElementById('sug-disaster').textContent = matchedCondition.disasterType || 'N/A';
    document.getElementById('sug-crop').textContent = cropType;
    document.getElementById('sug-damage').textContent = suggestedDamage + '%';
    document.getElementById('sug-severity').textContent = matchedCondition.severity;

    console.log('🤖 AI Analysis Complete:', {
        cropType: cropType,
        condition: conditionName,
        confidence: confidencePct,
        provider: analysis.provider
    });

    document.getElementById('scanner-loading').style.display = 'none';
    document.getElementById('scanner-results').style.display = 'block';
    document.getElementById('captured-preview-area').style.display = 'block';

    // Render map if GPS is available
    if (_scanGPS) {
        renderMap(_scanGPS.lat, _scanGPS.lng);
    }
}

// ══════════════════════════════════════════════
//  Fill Damage Report Form from Scan Results
// ══════════════════════════════════════════════
function fillReportFromScan() {
    if (!_aiResult) {
        alert('Mag-analyze muna ng larawan bago gamitin ang resulta.');
        return;
    }

    const cond = _aiResult.condition;
    const form = document.getElementById('damageReportForm');
    if (!form) return;

    // Set Disaster Type
    const disasterSelect = form.querySelector('[name="disasterType"]');
    if (disasterSelect && cond.disasterType) {
        for (let opt of disasterSelect.options) {
            if (opt.value === cond.disasterType) { disasterSelect.value = cond.disasterType; break; }
        }
    }

    // Set Crop Type
    const cropSelect = form.querySelector('[name="cropType"]');
    if (cropSelect && cond.cropType) {
        for (let opt of cropSelect.options) {
            if (opt.value === cond.cropType) { cropSelect.value = cond.cropType; break; }
        }
    }

    // Set Damage %
    const damageInput = form.querySelector('[name="damagePercentage"]');
    if (damageInput) damageInput.value = _aiResult.suggestedDamage;

    // Set Description
    const descTextarea = form.querySelector('[name="damageDescription"]');
    if (descTextarea) {
        const gpsNote = _scanGPS ? `\nGPS Coordinates: ${_scanGPS.lat.toFixed(5)}, ${_scanGPS.lng.toFixed(5)} (±${_scanGPS.accuracy}m)` : '';
        descTextarea.value = `[AI Scan Result - ${_aiResult.confidence}% confidence]\n${cond.description}\n\nRekomendasyon: ${cond.recommendation}${gpsNote}`;
    }

    // Set today's date as incident date
    const dateInput = form.querySelector('[name="incidentDate"]');
    if (dateInput && !dateInput.value) {
        dateInput.value = new Date().toISOString().split('T')[0];
    }

    // Set location if GPS obtained
    if (_scanGPS) {
        const locInput = form.querySelector('[name="location"]');
        if (locInput && !locInput.value) {
            locInput.value = `GPS: ${_scanGPS.lat.toFixed(5)}, ${_scanGPS.lng.toFixed(5)}`;
        }
    }

    // Add the scanned image to evidence photos
    if (_aiResult.capturedImage) {
        if (!window._evidenceImages) window._evidenceImages = [];
        if (window._evidenceImages.length < 3) {
            window._evidenceImages.push(_aiResult.capturedImage);
            if (typeof renderEvidencePreviews === 'function') renderEvidencePreviews();
        }
    }

    // Close scanner and open report modal
    closeCropScanner();
    setTimeout(() => {
        const reportModal = new bootstrap.Modal(document.getElementById('damageReportModal'));
        reportModal.show();

        // Show a helpful toast
        const toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;top:1rem;right:1rem;background:#059669;color:white;padding:0.875rem 1.5rem;border-radius:12px;font-weight:600;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,0.2);';
        toast.innerHTML = '<i class="fas fa-check-circle me-2"></i>Napunan na ang form mula sa AI scan! I-review at kumpletuhin ang natitirang fields.';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }, 300);
}
</script>

<script>
// ══════════════════════════════════════════════════
//  Test Google Vision API Connection
// ══════════════════════════════════════════════════
async function testGoogleVisionAPI() {
    // Show loading state
    const loadingToast = document.createElement('div');
    loadingToast.id = 'api-test-toast';
    loadingToast.style.cssText = 'position:fixed;top:1rem;right:1rem;background:#3b82f6;color:white;padding:0.875rem 1.5rem;border-radius:12px;font-weight:600;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,0.2);';
    loadingToast.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Testing Google Vision API...';
    document.body.appendChild(loadingToast);

    try {
        const response = await fetch('/api/ai/test');
        const data = await response.json();

        // Remove loading toast
        loadingToast.remove();

        // Create result toast
        const resultToast = document.createElement('div');
        resultToast.style.cssText = `position:fixed;top:1rem;right:1rem;background:${data.success ? '#22c55e' : '#ef4444'};color:white;padding:0.875rem 1.5rem;border-radius:12px;font-weight:600;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,0.2);max-width:400px;`;
        
        if (data.success) {
            resultToast.innerHTML = `
                <div style="display:flex;align-items:start;gap:0.5rem;">
                    <i class="fas fa-check-circle" style="font-size:1.2rem;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;margin-bottom:4px;">✅ API Working!</div>
                        <div style="font-size:0.85rem;opacity:0.9;">Google Vision API is configured correctly.</div>
                        <div style="font-size:0.75rem;opacity:0.8;margin-top:4px;">API Key: ${data.apiKeyPreview}</div>
                    </div>
                </div>
            `;
        } else {
            resultToast.innerHTML = `
                <div style="display:flex;align-items:start;gap:0.5rem;">
                    <i class="fas fa-times-circle" style="font-size:1.2rem;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;margin-bottom:4px;">❌ API Not Working</div>
                        <div style="font-size:0.85rem;opacity:0.9;">${data.message || 'API test failed'}</div>
                        ${data.configured ? `<div style="font-size:0.75rem;opacity:0.8;margin-top:4px;">Status: ${data.status} ${data.statusText}</div>` : ''}
                    </div>
                </div>
            `;
        }

        document.body.appendChild(resultToast);
        setTimeout(() => resultToast.remove(), 7000);

        // Log full response to console for debugging
        console.log('🧪 Google Vision API Test Result:', data);

    } catch (error) {
        loadingToast.remove();
        
        const errorToast = document.createElement('div');
        errorToast.style.cssText = 'position:fixed;top:1rem;right:1rem;background:#ef4444;color:white;padding:0.875rem 1.5rem;border-radius:12px;font-weight:600;z-index:99999;box-shadow:0 8px 25px rgba(0,0,0,0.2);max-width:400px;';
        errorToast.innerHTML = `
            <div style="display:flex;align-items:start;gap:0.5rem;">
                <i class="fas fa-exclamation-triangle" style="font-size:1.2rem;margin-top:2px;"></i>
                <div>
                    <div style="font-weight:700;margin-bottom:4px;">Test Failed</div>
                    <div style="font-size:0.85rem;opacity:0.9;">${error.message}</div>
                </div>
            </div>
        `;
        document.body.appendChild(errorToast);
        setTimeout(() => errorToast.remove(), 7000);

        console.error('❌ API Test Error:', error);
    }
}
</script>
