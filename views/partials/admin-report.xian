<!-- Admin Report Section (Staff Only) -->
<style>
.admin-report-container {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.admin-report-card {
    background: white;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.admin-list {
    max-height: 200px;
    overflow-y: auto;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 1rem;
    background: #f8f9fa;
}

.admin-item {
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    background: white;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.admin-item:hover {
    border-color: #667eea;
    transform: translateX(5px);
}

.admin-item.active {
    border-color: #667eea;
    background: linear-gradient(90deg, #f0f4ff 0%, #fff 100%);
}

.chat-container {
    height: 400px;
    overflow-y: auto;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 1rem;
    background: #f8f9fa;
}

.chat-message {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
}

.chat-message.sent {
    align-items: flex-end;
}

.chat-message.received {
    align-items: flex-start;
}

.chat-bubble {
    max-width: 70%;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    word-wrap: break-word;
}

.chat-message.sent .chat-bubble {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.chat-message.received .chat-bubble {
    background: white;
    border: 1px solid #e0e0e0;
    color: #333;
}

.chat-time {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.25rem;
}

.chat-sender {
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
    color: #4b5563;
}

.empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: #6b7280;
}

.empty-state i {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}
</style>

<div class="admin-report-container">
    <div class="admin-report-card">
        <h4 class="mb-4">
            <i class="fas fa-comment-dots me-2"></i>
            Report to Admin
        </h4>
        
        <div class="row">
            <!-- Admin List -->
            <div class="col-md-4">
                <h6 class="mb-3">Select Admin</h6>
                <div class="admin-list" id="adminList">
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p class="mb-0 mt-2">Loading admins...</p>
                    </div>
                </div>
            </div>
            
            <!-- Chat Area -->
            <div class="col-md-8">
                <div id="chatArea" style="display: none;">
                    <h6 class="mb-3">
                        Chat with <span id="selectedAdminName"></span>
                    </h6>
                    <div class="chat-container" id="adminChatMessages">
                        <div class="empty-state">
                            <i class="fas fa-comments"></i>
                            <p>No messages yet. Start the conversation!</p>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="input-group">
                            <textarea class="form-control" id="adminMessageInput" rows="2" placeholder="Type your message to admin..."></textarea>
                            <button class="btn btn-primary" onclick="sendAdminMessage()">
                                <i class="fas fa-paper-plane me-1"></i>Send
                            </button>
                        </div>
                    </div>
                </div>
                
                <div id="noAdminSelected" class="empty-state">
                    <i class="fas fa-user-shield"></i>
                    <p>Select an admin to start chatting</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let selectedAdminId = null;
let selectedAdminName = null;
let adminChatRefreshInterval = null;

// Load admin list when section is shown
document.addEventListener('DOMContentLoaded', function() {
    // This will be called when the section is shown
    if (typeof loadAdminList === 'undefined') {
        window.loadAdminList = function() {
            fetch('/api/messages/admins')
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.admins && data.admins.length > 0) {
                        displayAdminList(data.admins);
                    } else {
                        document.getElementById('adminList').innerHTML = `
                            <div class="text-center text-muted py-3">
                                <i class="fas fa-user-shield fa-2x mb-2"></i>
                                <p class="mb-0">No admins available</p>
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Error loading admins:', error);
                    document.getElementById('adminList').innerHTML = `
                        <div class="text-center text-danger py-3">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                            <p class="mb-0">Error loading admins</p>
                        </div>
                    `;
                });
        };
    }
});

function displayAdminList(admins) {
    const container = document.getElementById('adminList');
    container.innerHTML = admins.map(admin => `
        <div class="admin-item" onclick="selectAdmin('${admin.id}', '${admin.name}')">
            <div class="d-flex align-items-center">
                <i class="fas fa-user-shield me-2 text-primary"></i>
                <div>
                    <div class="fw-bold">${admin.name}</div>
                    <small class="text-muted">${admin.email}</small>
                </div>
            </div>
        </div>
    `).join('');
}

function selectAdmin(adminId, adminName) {
    selectedAdminId = adminId;
    selectedAdminName = adminName;
    
    // Update UI
    document.querySelectorAll('.admin-item').forEach(item => item.classList.remove('active'));
    event.currentTarget.classList.add('active');
    
    document.getElementById('selectedAdminName').textContent = adminName;
    document.getElementById('chatArea').style.display = 'block';
    document.getElementById('noAdminSelected').style.display = 'none';
    
    // Load messages
    loadAdminChatMessages();
    
    // Start auto-refresh
    if (adminChatRefreshInterval) clearInterval(adminChatRefreshInterval);
    adminChatRefreshInterval = setInterval(loadAdminChatMessages, 3000);
}

function loadAdminChatMessages() {
    if (!selectedAdminId) return;
    
    fetch(`/api/messages/conversation/${selectedAdminId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                displayAdminChatMessages(data.messages);
            }
        })
        .catch(error => console.error('Error loading messages:', error));
}

function displayAdminChatMessages(messages) {
    const container = document.getElementById('adminChatMessages');
    
    if (!messages || messages.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-comments"></i>
                <p>No messages yet. Start the conversation!</p>
            </div>
        `;
        return;
    }
    
    container.innerHTML = messages.map(msg => {
        const isSent = msg.senderRole === 'staff';
        const messageClass = isSent ? 'sent' : 'received';
        const time = new Date(msg.createdAt).toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
        
        return `
            <div class="chat-message ${messageClass}">
                ${!isSent ? `<div class="chat-sender">${msg.senderName}</div>` : ''}
                <div class="chat-bubble">${msg.message}</div>
                <div class="chat-time">${time}</div>
            </div>
        `;
    }).join('');
    
    // Scroll to bottom
    container.scrollTop = container.scrollHeight;
}

function sendAdminMessage() {
    const input = document.getElementById('adminMessageInput');
    const message = input.value.trim();
    
    if (!message || !selectedAdminId) return;
    
    fetch('/api/messages/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            receiverId: selectedAdminId,
            receiverName: selectedAdminName,
            message: message
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            input.value = '';
            loadAdminChatMessages();
        } else {
            alert('Failed to send message');
        }
    })
    .catch(error => {
        console.error('Error sending message:', error);
        alert('Error sending message');
    });
}

// Allow Enter to send (Shift+Enter for new line)
document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('adminMessageInput');
    if (input) {
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendAdminMessage();
            }
        });
    }
});

// Clean up interval when leaving section
window.addEventListener('beforeunload', function() {
    if (adminChatRefreshInterval) {
        clearInterval(adminChatRefreshInterval);
    }
});
</script>
